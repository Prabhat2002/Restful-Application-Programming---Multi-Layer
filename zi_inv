@AbapCatalog.viewEnhancementCategory: [#NONE]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Company Interview'
@Metadata.ignorePropagatedAnnotations: true
@ObjectModel.usageType:{
  serviceQuality: #X,
  sizeCategory: #S,
  dataClass: #MIXED
}
define view entity zi_comp_inv
  as select from zdt_comp_inv
  association to parent ZI_COMP_ITEM as _ITEM on  $projection.Icon  = _ITEM.Icon
                                              and $projection.Jobid = _ITEM.Jobid
                                              and $projection.Name  = _ITEM.Name
{
  key icon          as Icon,
  key name          as Name,
  key jobid         as Jobid,
  key status        as Status,
      add_comm      as AddComm,
      lastchangedat as Lastchangedat,
      _ITEM
}
